# Copy to .env or export these before `npm start`.
PORT=3000
NODE_ENV=production
# Everything is served under this path (pages, static files, Socket.IO at <BASE_PATH>/socket.io).
BASE_PATH=/games
# Public origin phones open (goes into the QR codes). Leave empty on a local Wi-Fi: the LAN address is detected.
PUBLIC_URL=https://gdg.example.com
# Game stations: HS256 key shared with the platform (backend Games:StationSigningKey). At least 32 bytes. REQUIRED in production.
# Generate with: openssl rand -base64 48   — never commit the real value.
GAMES_STATION_KEY=change-me-to-at-least-32-random-characters
# Platform backend used to check that a station is still open. REQUIRED in production. (docker: http://backend:8080)
PLATFORM_API_URL=http://localhost:5000
# Optional: "Registration Team member? Sign in" link on the Hold on page (default: PUBLIC_URL + /)
# STATIONS_URL=https://gdg.example.com/
# Optional: where the static builds live (default: the sibling ../Code-Man and ../CodeBreaker folders)
# CODEMAN_DIR=../Code-Man
# CODEBREAKER_DIR=../CodeBreaker
# Local development only: with NODE_ENV != production and no GAMES_STATION_KEY, hosts log in with this key
# (default "gdg-race"). Ignored in production.
# HOST_SECRET=gdg-race
# Set to 1 when running behind a TLS proxy and you want http:// redirected to https://
FORCE_HTTPS=0
