# Copy to .env or export these before `npm start`.
PORT=3000
NODE_ENV=production
# Public https URL that phones will open (goes into the QR code). Leave empty on a local Wi-Fi: the LAN address is detected.
PUBLIC_URL=https://race.example.com
# The organiser's key for /host. REQUIRED when NODE_ENV=production. Never commit the real value.
HOST_SECRET=change-me-to-a-long-random-string
# Set to 1 when running behind a TLS proxy and you want http:// redirected to https://
FORCE_HTTPS=0
